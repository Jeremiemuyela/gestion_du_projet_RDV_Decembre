      </>
    )
  }
  {
    name === 'pair' && (
      <>
        <circle cx="8" cy="8" r="2.2" />
        <circle cx="16.2" cy="8" r="2.2" />
        <path d="M3.8 18.8v-1.2A3.2 3.2 0 0 1 7 14.4h2.2M14.2 14.6H17a3.2 3.2 0 0 1 3.2 3.2v1" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="2" />
        <path d="M8 10.5v6M8 7.6h.01M12 16.5v-3.4a2 2 0 0 1 4 0v3.4" />
      </>
    )
  }
  {
    name === 'tiktok' && (
      <>
        <path d="M14 6.2c.6 1.6 1.8 2.6 3.5 2.8" />
        <path d="M14 6.2v8.2a3.6 3.6 0 1 1-3.6-3.6" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="4.5" y="4.5" width="15" height="15" rx="4" />
        <circle cx="12" cy="12" r="3.3" />
        <circle cx="16.6" cy="7.5" r="0.7" fill="currentColor" stroke="none" />
