---
interface Props {
  name:
    | 'network'
    | 'stand'
    | 'growth'
    | 'sun'
    | 'ballot'
    | 'star'
    | 'users'
    | 'ticket'
    | 'cash'
    | 'phone'
    | 'info'
    | 'agenda'
    | 'bow'
    | 'clock'
    | 'trophy'
    | 'pair'
    | 'linkedin'
    | 'tiktok'
    | 'instagram';
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    name === 'network' && (
      <>
        <circle cx="7" cy="8" r="2.2" />
        <circle cx="17" cy="8" r="2.2" />
        <circle cx="12" cy="16.5" r="2.2" />
        <path d="M8.8 9.4 10.6 14.4M15.2 9.4 13.4 14.4M9.2 8h5.6" />
      </>
    )
  }
  {
    name === 'stand' && (
      <>
        <path d="M4 10h16" />
        <path d="M6 10V7.2L12 4l6 3.2V10" />
        <path d="M6 10v9h12v-9" />
        <path d="M10 19v-5h4v5" />
      </>
    )
  }
  {
    name === 'growth' && (
      <>
        <path d="M4 19V5" />
        <path d="M4 19h16" />
        <path d="m7 14 4-4 3 2.2L19 7" />
        <path d="M15 7h4v4" />
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="3.4" />
        <path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18" />
      </>
