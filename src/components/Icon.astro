  }
  {
    name === 'star' && (
      <path d="m12 3.4 2.1 6.2h6.5l-5.2 3.9 2 6.3L12 16.2 6.6 19.8l2-6.3L3.4 9.6h6.5z" />
    )
  }
  {
    name === 'users' && (
      <>
        <path d="M16 20.5v-1.8a3.6 3.6 0 0 0-3.6-3.6H7.2A3.6 3.6 0 0 0 3.6 18.7v1.8" />
        <circle cx="9.8" cy="8.2" r="2.7" />
        <path d="M20.4 20.5v-1.6a3.4 3.4 0 0 0-2.6-3.3" />
        <path d="M15.2 5.6a2.7 2.7 0 0 1 0 5.1" />
      </>
    )
  }
  {
    name === 'ticket' && (
      <path d="M4.5 8.2A1.8 1.8 0 0 1 6.3 6.4h11.4a1.8 1.8 0 0 1 1.8 1.8v1.6a1.7 1.7 0 0 0 0 3.4v1.6a1.8 1.8 0 0 1-1.8 1.8H6.3a1.8 1.8 0 0 1-1.8-1.8v-1.6a1.7 1.7 0 0 0 0-3.4z" />
    )
  }
  {
    name === 'cash' && (
      <>
        <rect x="3.5" y="6.5" width="17" height="11" rx="2" />
        <circle cx="12" cy="12" r="2.3" />
      </>
    )
  }
  {
    name === 'phone' && (
      <>
        <rect x="8" y="3" width="8" height="18" rx="2" />
        <path d="M11 17.5h2" />
      </>
    )
  }
  {
    name === 'info' && (
      <>
        <circle cx="12" cy="12" r="8" />
        <path d="M12 11v5.2" />
        <path d="M12 8h.01" />
      </>
    )
  }
  {
    name === 'agenda' && (
